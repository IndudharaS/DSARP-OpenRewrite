{
  "project": "logging-log4j2",
  "systems": ["logging-log4j2", "log4j2"],
  "repository_urls": ["https://github.com/apache/logging-log4j2.git"],
  "maven_test_excludes": ["**/FileAppenderPermissionsTest.*"],
  "maven_fork_count": "1",
  "compatibility_strategies": [
    {
      "source_type": "org.apache.logging.log4j.core.appender.rolling.FileSize",
      "destination_type": "org.apache.logging.log4j.core.appender.rolling.action.FileSize",
      "strategy": "file_size_facade"
    }
  ]
}
